---
import '@fontsource-variable/manrope';
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title?: string; description?: string }
const { title = 'El siguiente nivel empieza contigo', description = 'Explora los programas de maestría y doctorado de la Unidad de Posgrado de la Universidad Nacional de Cañete.' } = Astro.props;
---
<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#103bdd" />
    <!-- Retirar noindex y configurar canonical/site cuando se apruebe el dominio. -->
    <meta name="robots" content="noindex, nofollow" />
    <meta property="og:title" content={`${title} | Posgrado UNDC`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_PE" />
    <link rel="icon" type="image/png" href="/images/logo-fi-upg.png?v=2" />
    <title>{title} | Posgrado UNDC</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido"><slot /></main>
    <Footer />
  </body>
</html>
