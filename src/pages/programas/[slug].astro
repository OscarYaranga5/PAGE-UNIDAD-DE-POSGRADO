---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import ProgramCard from '../../components/ProgramCard.astro';
import CallToAction from '../../components/CallToAction.astro';
import { programs, type Program } from '../../data/programs';
export function getStaticPaths() {
  // Astro genera una página HTML por registro; esta ruta no consulta una API.
  return programs.map((program) => ({ params: { slug: program.slug }, props: { program } }));
}
interface Props { program: Program }
const { program } = Astro.props;
const related = programs.filter((item) => item.slug !== program.slug);
---
<BaseLayout title={`${program.type} en ${program.title}`} description={program.description}>
  <section class="detail-hero"><div class="container"><nav class="breadcrumbs" aria-label="Ruta de navegación"><a href="/">Inicio</a><span>/</span><a href="/programas/">Programas</a><span>/</span><span>{program.title}</span></nav><div class="detail-hero-grid"><div><span class="eyebrow">{program.type} · {program.area}</span><h1>{program.title}</h1><p>{program.description}</p><a href={`/contacto/?programa=${program.slug}`} class="button">Solicita información <Icon /></a></div><img src={program.image} alt={program.imageAlt} width="900" height="600" fetchpriority="high" /></div><dl class="program-facts"><div><dt>Grado de formación</dt><dd>{program.type}</dd></div><div><dt>Duración</dt><dd>{program.semesters} semestres</dd></div><div><dt>Modalidad</dt><dd>Presencial</dd></div><div><dt>Institución</dt><dd>UNDC</dd></div></dl></div></section>
  <section class="section"><div class="container detail-content"><div><span class="eyebrow">TU EXPERIENCIA, UNA NUEVA PERSPECTIVA</span><h2>¿Es el siguiente<br />paso para ti?</h2><p class="large-copy">{program.audience}</p><h3 class="subheading">Áreas que podrás desarrollar</h3><ul class="skills-list">{program.skills.map((skill) => <li><Icon name="check" /><span>{skill}</span></li>)}</ul><div class="editorial-note"><strong>Consulta el detalle académico.</strong><p>Revisa la malla curricular, el perfil de egreso y las condiciones del programa en su ficha institucional.</p><a class="text-link" href={program.source}>Ver ficha oficial <Icon name="diagonal" /></a></div></div><aside class="adviser-card"><span class="eyebrow">ESTAMOS PARA ORIENTARTE</span><h2>Conversemos sobre tu próximo paso.</h2><p>Consulta los requisitos, la inversión y las fechas de la convocatoria vigente.</p><a class="button" href={`/contacto/?programa=${program.slug}`}>Quiero orientación <Icon /></a><a class="text-link" href="/admision/">Conoce cómo postular <Icon /></a><small>La disponibilidad de vacantes se confirma con el equipo de admisión.</small></aside></div></section>
  <section class="section section--soft"><div class="container"><div class="section-heading"><div><span class="eyebrow">SIGUE EXPLORANDO</span><h2>Otros caminos para crecer.</h2></div></div><div class="program-grid program-grid--two">{related.map((item, index) => <ProgramCard program={item} index={index} />)}</div></div></section>
  <CallToAction />
</BaseLayout>
