---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { news, formatNewsDate, type NewsItem } from '../../data/news';
export function getStaticPaths() {
  return news.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}
interface Props {
  item: NewsItem;
}
const { item } = Astro.props;
---

<BaseLayout title={item.title} description={item.excerpt}>
  <article class="section news-article container">
    <nav class="breadcrumbs" aria-label="Ruta de navegación">
      <a href="/">Inicio</a>
      <span aria-hidden="true">/</span>
      <a href="/noticias/">Noticias</a>
    </nav>
    <span class="eyebrow">{item.category}</span>
    <h1>{item.title}</h1>
    <p class="article-date">
      {item.publishedAt ? (
        <time datetime={item.publishedAt}>
          {formatNewsDate(item.publishedAt)}
        </time>
      ) : (
        'Pendiente de publicación'
      )}
    </p>
    {item.isDemo && (
      <aside class="editorial-note">
        <strong>Contenido de muestra</strong>
        <p>
          Esta publicación permite revisar el diseño y la navegación. No es una
          noticia ni un anuncio oficial de la UNDC.
        </p>
      </aside>
    )}
    <figure>
      <img
        src={item.image}
        alt={item.imageAlt}
        width="900"
        height="600"
        fetchpriority="high"
      />
      <figcaption>Fotografía referencial.</figcaption>
    </figure>
    <div class="article-text">
      {item.paragraphs.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
    </div>
    <a class="text-link" href="/noticias/">
      Ver todas las noticias <Icon />
    </a>
  </article>
</BaseLayout>

<style>
  .news-article {
    max-width: 900px;
  }
  .news-article h1 {
    font-size: clamp(2.1rem, 4vw, 3.5rem);
  }
  .article-date {
    margin-top: 20px;
    font-size: 0.85rem;
  }
  .news-article figure {
    margin-block: 35px;
  }
  .news-article figure img {
    aspect-ratio: 1.8;
    object-fit: cover;
    border-radius: 18px;
  }
  .news-article figcaption {
    font-size: 0.7rem;
    color: var(--muted);
    margin-top: 10px;
  }
  .article-text p {
    margin-bottom: 22px;
    font-size: 1rem;
    line-height: 1.9;
  }
  .news-article > .text-link {
    margin-top: 15px;
  }
</style>
