---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import CallToAction from '../components/CallToAction.astro';
import Icon from '../components/Icon.astro';
import { programs } from '../data/programs';
---

<BaseLayout
  title="Investigación con propósito"
  description="Explora el enfoque de investigación de los programas de posgrado de la UNDC."
>
  <PageIntro
    eyebrow="Investigación"
    title="Las buenas preguntas abren nuevos caminos."
    description="Conecta tu experiencia profesional con una mirada crítica, el método científico y los desafíos de tu entorno."
  />
  <section class="section">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">CONOCIMIENTO EN CONSTRUCCIÓN</span>
          <h2>
            Una mirada desde
            <br />
            cada especialidad.
          </h2>
        </div>
        <p>
          La investigación forma parte de las competencias descritas en las
          fichas institucionales de nuestros programas.
        </p>
      </div>
      <div class="values-grid">
        {programs.map((program) => (
          <article>
            <Icon name="book" size={32} />
            <span class="eyebrow">{program.type}</span>
            <h3>{program.title}</h3>
            <p>
              {program.skills[program.skills.length - 1]}. Conoce el perfil de
              formación y consulta el detalle académico del programa.
            </p>
            <a
              class="text-link research-link"
              href={`/programas/${program.slug}/`}
            >
              Explorar programa <Icon />
              <span class="sr-only">{program.title}</span>
            </a>
          </article>
        ))}
      </div>
      <aside class="editorial-note">
        <strong>Construye tu siguiente pregunta.</strong>
        <p>
          Si tienes una idea de investigación, consulta con el equipo de
          posgrado su relación con el programa que te interesa. Las líneas
          oficiales y los requisitos se revisan en la documentación académica
          vigente.
        </p>
        <a class="text-link" href="/contacto/">
          Solicitar orientación <Icon />
        </a>
      </aside>
    </div>
  </section>
  <CallToAction />
</BaseLayout>
<style>
  .research-link {
    margin-top: 25px;
  }
</style>
