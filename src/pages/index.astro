---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ProgramExplorer from '../components/ProgramExplorer.astro';
import CallToAction from '../components/CallToAction.astro';
import Faq from '../components/Faq.astro';
import DiscoverCards from '../components/DiscoverCards.astro';
import HomeHero from '../components/HomeHero.astro';
import NewsSection from '../components/NewsSection.astro';
---

<BaseLayout>
  <HomeHero />
  <div class="value-strip">
    <div class="container value-strip-inner">
      <span>
        <Icon name="book" /> Maestrías y doctorado
      </span>
      <span>
        <Icon name="spark" /> Investigación con propósito
      </span>
      <span>
        <Icon name="globe" /> Desde Cañete, hacia el futuro
      </span>
    </div>
  </div>

  <section class="section" id="programas">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="eyebrow">
            <span class="label-line"></span> ENCUENTRA TU CAMINO
          </span>
          <h2>
            Un siguiente nivel.
            <br />
            <span class="muted-title">Un programa para ti.</span>
          </h2>
        </div>
        <p>
          Elige la formación que conecta con tus metas.
          <br />
          La próxima decisión que transforma tu carrera empieza aquí.
        </p>
      </div>
      <ProgramExplorer />
      <div class="section-tail">
        <p>
          Consulta la disponibilidad de cada programa en la convocatoria
          vigente.
        </p>
        <a class="text-link" href="/programas/">
          Conoce la oferta académica <Icon />
        </a>
      </div>
    </div>
  </section>

  <DiscoverCards />

  <NewsSection />

  <section class="section community-section">
    <div class="container community-grid">
      <div>
        <span class="eyebrow">CONECTA CON POSGRADO</span>
        <h2>
          La comunidad
          <br />
          sigue creciendo.
        </h2>
        <p>
          Información académica, actividades y recursos para acompañar tu
          siguiente etapa.
        </p>
        <a class="text-link" href="https://posgrado.undc.edu.pe/">
          Visita el portal institucional <Icon name="diagonal" />
        </a>
      </div>
      <div class="resource-list">
        <a href="/admision/">
          <span class="resource-type">ADMISIÓN</span>
          <h3>Todo comienza con una buena decisión.</h3>
          <span>Conoce la ruta para postular</span>
          <Icon name="diagonal" size={26} />
        </a>
        <a href="https://aulaposgrado.undc.edu.pe/">
          <span class="resource-type">COMUNIDAD ACADÉMICA</span>
          <h3>Tu espacio para seguir aprendiendo.</h3>
          <span>Accede al aula virtual</span>
          <Icon name="diagonal" size={26} />
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container faq-grid">
      <div>
        <span class="eyebrow">RESOLVEMOS TUS DUDAS</span>
        <h2>
          Antes de dar
          <br />
          el siguiente paso.
        </h2>
        <a href="/contacto/" class="text-link">
          Habla con nosotros <Icon />
        </a>
      </div>
      <Faq />
    </div>
  </section>
  <CallToAction />
</BaseLayout>
