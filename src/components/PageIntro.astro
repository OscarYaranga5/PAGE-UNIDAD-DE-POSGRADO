---
interface Props { eyebrow: string; title: string; description: string }
const { eyebrow, title, description } = Astro.props;
---
<section class="page-intro"><div class="container"><nav aria-label="Ruta de navegación" class="breadcrumbs"><a href="/">Inicio</a><span aria-hidden="true">/</span><span>{eyebrow}</span></nav><span class="eyebrow">{eyebrow}</span><h1>{title}</h1><p>{description}</p><span class="intro-ring" aria-hidden="true"></span></div></section>
