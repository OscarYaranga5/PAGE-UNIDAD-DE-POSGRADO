---
import NewsCards from './NewsCards.astro';
import Icon from './Icon.astro';
import SectionTitle from './SectionTitle.astro';
import { news } from '../data/news';
---

<section
  class="section news-section"
  id="noticias"
  aria-labelledby="news-title"
>
  <div class="container">
    <header class="news-heading">
      <SectionTitle
        id="news-title"
        primary="Últimas noticias."
        secondary="Conocimiento que conecta."
      />
    </header>
    <NewsCards items={news.slice(0, 3)} />
    <a class="news-all" href="/noticias/">
      Ver todas las noticias <Icon />
    </a>
  </div>
</section>

<style>
  .news-section {
    background: var(--white);
  }
  .news-heading {
    margin-bottom: 46px;
  }
  .news-all {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 15px;
    width: 100%;
    min-height: 52px;
    margin-top: 52px;
    padding: 13px 22px;
    background: var(--blue);
    color: white;
    border-radius: 100px;
    text-transform: uppercase;
    font-size: 0.85rem;
    font-weight: 700;
    text-align: center;
    transition: background 0.2s;
  }
  .news-all:hover {
    background: var(--blue-hover);
  }
  @media (max-width: 767px) {
    .news-heading {
      margin-bottom: 32px;
    }
    .news-all {
      margin-top: 35px;
      font-size: 0.76rem;
    }
  }
</style>
